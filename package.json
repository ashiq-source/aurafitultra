{
  "name": "aurafit-ai-ultra",
  "private": true,
  "type": "module",
  "version": "8.0.0",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check aurafit-ultra-app.js && node --check aurafit-phase5.js && node --check aurafit-phase6.js && node --check aurafit-phase7.js && node --check aurafit-ultra-data-layer.js && node --check aurafit-migration-engine.js && node --check aurafit-phase8.js && node --check aurafit-cloud.js && node --check aurafit-android.js && node --check aurafit-gemini.js",
    "test": "node --test test-phase*.mjs test-android-phase.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew bundleRelease",
    "build:android:web": "node scripts/build-android-web.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@supabase/supabase-js": "^2.57.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "capacitor-secure-storage-plugin": "0.13.0",
    "@capacitor/status-bar": "8.0.4",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.25.0"
  }
}
