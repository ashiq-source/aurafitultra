# Keep this file private. Copy to .env on the server and insert your Google AI Studio API key.
GEMINI_API_KEY=replace_with_server_secret
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_URL=https://loqndxqwvhdhtujpneup.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_publishable_key
GEMINI_MAX_OUTPUT_TOKENS=1800
AI_RATE_LIMIT_PER_MINUTE=12
PORT=3000
NODE_ENV=development
# In production, set exact frontend origin(s), comma-separated. Example: https://your-domain.example
ALLOWED_ORIGINS=
# Set to 1 only when correctly behind one trusted reverse proxy.
TRUST_PROXY=0
