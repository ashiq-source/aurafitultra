{
  "appId": "com.aurafit.aiultra",
  "appName": "AuraFit AI Ultra",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "backgroundColor": "#0b0920",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false,
      "initialViewportFitValueHint": "cover"
    }
  }
}
